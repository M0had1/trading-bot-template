{
  "buildCommand": "node ./node_modules/@rsbuild/core/bin/rsbuild.js build",
  "outputDirectory": "dist",
  "framework": "other",
  "installCommand": "npm install --legacy-peer-deps",
  "env": {
    "NODE_ENV": "production",
    "CLIENT_ID": "@client_id",
    "APP_ENV": "production"
  },
  "envPrefix": "REACT_APP_",
  "regions": ["iad1"],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
